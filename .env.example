# Copy to .env. Every value shown is the default.
OCR_MAX_UPLOAD_MB=25
OCR_MAX_PAGES=50
OCR_RENDER_DPI=200
OCR_MAX_IMAGE_SIDE=4000
OCR_MAX_IMAGE_PIXELS=100000000
OCR_MAX_DOCX_UNCOMPRESSED_MB=100
OCR_NATIVE_MIN_CHARS=20
OCR_PADDLE_DET_MAX_SIDE=1280
OCR_PROCESSING_TIMEOUT_SECONDS=600
OCR_BATCH_MAX_FILES=5
OCR_JOB_TTL_SECONDS=3600
OCR_JOB_MAX_ACTIVE=20
OCR_JOB_MAX_STORED=100
OCR_SYNC_MAX_ACTIVE=10
OCR_MODEL_CACHE_DIR=models
OCR_TESSERACT_CMD=tesseract
# JSON list. Empty = same-origin only.
OCR_CORS_ORIGINS=[]
OCR_LOG_LEVEL=INFO
